                        "index": 0
                      },
                      "fail": {
                        "color": "#dc3c3d",
                        "index": 1
                      },
                      "unknown": {
                        "color": "#fbb315",
                        "index": 2
                      },
                      "not_applicable": {
                        "color": "text",
                        "index": 3
                      },
                      "error": {
