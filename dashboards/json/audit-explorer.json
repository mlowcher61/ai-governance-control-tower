            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT bundle_revision AS revision, CASE WHEN in_use THEN 'in use' ELSE 'history' END AS status, first_used_at AS \"first used\", last_used_at AS \"last used\", evaluations, agents FROM reporting.bundle_revisions ORDER BY last_used_at DESC"
        }
