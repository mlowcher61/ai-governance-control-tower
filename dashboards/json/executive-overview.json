            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(avg(detect_minutes), 1) AS minutes FROM reporting.findings_event_attributed WHERE $__timeFilter(first_detected_at)"
        }
      ],
      "description": "Minutes from the AWS change (CloudTrail event time) to the finding, for findings an AWS change led to (Event-Driven Ansible, WF-03). Target: 5 minutes or less.",
