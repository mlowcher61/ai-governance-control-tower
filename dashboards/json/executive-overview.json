    {
      "id": 7,
      "type": "bargauge",
      "title": "Compliance status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE compliance_status = 'compliant') AS \"compliant\", count(*) FILTER (WHERE compliance_status = 'noncompliant') AS \"noncompliant\", count(*) FILTER (WHERE compliance_status IN ('unknown', 'error')) AS \"unknown or error\", count(*) FILTER (WHERE compliance_status = 'not_evaluated') AS \"not evaluated\" FROM reporting.agent_current"
        }
      ],
      "description": "Unknown means the policy could not decide because evidence was missing.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#338ced"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "compliant"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0aac23"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "noncompliant"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#dc3c3d"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown or error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fbb315"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "not evaluated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "namePlacement": "top",
