  "panels": [
    {
      "id": 4,
      "type": "table",
      "title": "Agent",
      "description": "What discovery and the governance registry know about the agent.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT name AS agent, platform, account_ref AS account, region, environment, registration_status AS registration, coalesce(registration_id, '-') AS registration_id, coalesce(owner_name, '-') AS owner, status, coalesce(model, 'unknown') || CASE WHEN model_declared THEN ' (declared by owner)' ELSE '' END AS model, execution_role FROM reporting.agent_current WHERE agent_id = '$agent'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
