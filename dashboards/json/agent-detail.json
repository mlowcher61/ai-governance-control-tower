    {
      "id": 9,
      "type": "table",
      "title": "Policy results",
      "description": "Every governance policy's result in the latest assessment, with the controls it provides evidence for.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT policy_id AS policy, decision, severity, explanation AS \"policy explanation\", coalesce(ai_headline, '-') AS \"AI explanation (advisory)\", array_to_string(assumptions, ', ') AS assumptions, array_to_string(controls, ', ') AS controls FROM reporting.policy_results_latest WHERE agent_id = '$agent' ORDER BY CASE decision WHEN 'fail' THEN 1 WHEN 'unknown' THEN 2 WHEN 'pass' THEN 3 ELSE 4 END, policy_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "decision"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
