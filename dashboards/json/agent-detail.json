          "rawQuery": true,
          "rawSql": "SELECT kind, type, name, coalesce(state, '-') AS state, coalesce(classification, '-') AS classification, CASE approved WHEN true THEN 'approved' WHEN false THEN 'not approved' ELSE '-' END AS \"high-risk tool approval\", last_seen_at AS \"last seen\" FROM reporting.agent_resources WHERE agent_id = '$agent' ORDER BY kind DESC, name"
        }
