    {
      "id": 9,
      "type": "barchart",
      "title": "Agents by risk category",
      "description": "Deterministic risk score bands: critical 70+, high 45-69, medium 21-44, low 20 or less.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 4,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT risk_category AS category, count(*) AS agents FROM reporting.agent_current GROUP BY risk_category, risk_rank ORDER BY risk_rank"
