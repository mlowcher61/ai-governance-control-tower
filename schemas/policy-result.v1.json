{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlowcher61/ai-governance-control-tower/schemas/policy-result.v1.json",
  "title": "Per-policy result, version 1",
  "description": "What one governance policy returns for one agent (docs/plan/03 section 6.3). Stored by api.record_evaluation in aigov.policy_results.",
  "type": "object",
  "required": ["policy_id", "policy_version", "title", "decision", "severity", "explanation", "evidence", "assumptions", "controls"],
  "additionalProperties": false,
  "properties": {
    "agent_id": {"$ref": "common.v1.json#/$defs/uuid"},
    "policy_id": {"$ref": "common.v1.json#/$defs/policy_id"},
    "policy_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"$ref": "common.v1.json#/$defs/non_empty_string"},
    "decision": {"$ref": "common.v1.json#/$defs/decision"},
    "severity": {"$ref": "common.v1.json#/$defs/severity"},
    "explanation": {"$ref": "common.v1.json#/$defs/non_empty_string", "description": "Deterministic, plain-language reason. Never generated by AI."},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Path into the policy input, for example identity.policies[0].ref."},
          "value": {}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"enum": ["environment_assumed_production", "value_declared_by_owner"]},
      "uniqueItems": true
    },
    "remediation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["summary", "action_types", "automatable"],
          "additionalProperties": false,
          "properties": {
            "summary": {"type": "string"},
            "action_types": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
            "automatable": {"type": "boolean"}
          }
        }
      ]
    },
    "controls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "description": "Only failing results carry a remediation.",
      "if": {"properties": {"decision": {"not": {"const": "fail"}}}},
      "then": {"properties": {"remediation": {"type": "null"}}}
    }
  ]
}
