    {
      "id": 11,
      "type": "table",
      "title": "AI agents",
      "description": "Every agent in the inventory. Select an agent name to open its detail dashboard.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT agent_id, name AS agent, compliance_status AS compliance, risk_category AS risk, risk_score AS score, registration_status AS registration, coalesce(owner_name, '-') AS owner, environment, platform, account_ref AS account, region, open_findings, last_evaluated_at FROM reporting.agent_current ORDER BY risk_rank, risk_score DESC NULLS LAST, name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "agent_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "compliance"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "compliant": {
                        "color": "#0aac23",
                        "index": 0
                      },
                      "noncompliant": {
                        "color": "#dc3c3d",
                        "index": 1
                      },
                      "unknown": {
                        "color": "#fbb315",
                        "index": 2
                      },
                      "error": {
                        "color": "#f18a59",
                        "index": 3
                      },
                      "not_evaluated": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "#dc3c3d",
                        "index": 0
                      },
                      "high": {
                        "color": "#f18a59",
                        "index": 1
                      },
                      "medium": {
                        "color": "#fbb315",
                        "index": 2
                      },
                      "low": {
                        "color": "#0aac23",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "agent"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Agent detail",
                    "url": "/d/aigov-agent-detail/ai-governance-agent-detail?var-agent=${__data.fields.agent_id}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
