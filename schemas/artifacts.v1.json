{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mlowcher61/ai-governance-control-tower/schemas/artifacts.v1.json",
  "title": "AAP job artifacts used by automation orchestrator, version 1",
  "description": "What each governance job template publishes with ansible.builtin.set_stats. automation orchestrator reads these as ${<node_id>.artifacts.<name>} (docs/plan/03 section 9.2). Pick the definition for a job with $defs/<job>. AO passes values between nodes as text, so numbers may arrive as strings; jobs must accept both.",
  "$defs": {
    "count": {
      "description": "A count. A string of digits is accepted because AO may pass numbers as text.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+$"
        }
      ]
    },
    "discover": {
      "title": "AI Governance - Discover AI Agents",
      "type": "object",
      "required": [
        "governance_run_id",
        "discovery_run_id",
        "agents_discovered",
        "discovery_status"
      ],
      "additionalProperties": false,
      "properties": {
        "governance_run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "discovery_run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "agents_discovered": {
          "$ref": "#/$defs/count"
        },
        "agents_changed": {
          "$ref": "#/$defs/count"
        },
        "agents_missing": {
          "$ref": "#/$defs/count"
        },
        "discovery_status": {
          "enum": [
            "succeeded",
            "partial",
            "failed"
          ]
        }
      }
    },
    "evaluate": {
      "title": "AI Governance - Evaluate Governance Policies",
      "type": "object",
      "required": [
        "governance_run_id",
        "noncompliant_count",
        "unknown_count",
        "explain_count",
        "findings_for_explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "governance_run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "evaluated_count": {
          "$ref": "#/$defs/count"
        },
        "compliant_count": {
          "$ref": "#/$defs/count"
        },
        "noncompliant_count": {
          "$ref": "#/$defs/count"
        },
        "unknown_count": {
          "$ref": "#/$defs/count"
        },
        "explain_count": {
          "$ref": "#/$defs/count"
        },
        "findings_for_explanation": {
          "type": "string",
          "description": "JSON text of a findings-for-explanation.v1.json array (at most 10 findings)."
        },
        "bundle_revision": {
          "type": "string"
        }
      }
    },
    "record_explanations": {
      "title": "AI Governance - Record AI Explanations",
      "type": "object",
      "required": [
        "recorded"
      ],
      "additionalProperties": false,
      "properties": {
        "recorded": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "summary": {
      "title": "AI Governance - Publish Assessment Summary",
      "type": "object",
      "required": [
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "governance_run_id",
            "agents",
            "compliant",
            "noncompliant",
            "unknown",
            "open_findings"
          ],
          "additionalProperties": false,
          "properties": {
            "governance_run_id": {
              "$ref": "common.v1.json#/$defs/uuid"
            },
            "agents": {
              "type": "integer",
              "minimum": 0
            },
            "compliant": {
              "type": "integer",
              "minimum": 0
            },
            "noncompliant": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            },
            "open_findings": {
              "type": "integer",
              "minimum": 0
            },
            "critical_findings": {
              "type": "integer",
              "minimum": 0
            },
            "grafana_url": {
              "type": "string"
            }
          }
        }
      }
    },
    "finding_context": {
      "title": "AI Governance - Get Finding Context",
      "type": "object",
      "required": [
        "governance_run_id",
        "finding_id",
        "finding_status"
      ],
      "additionalProperties": false,
      "properties": {
        "governance_run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "finding_id": {
          "type": "string"
        },
        "finding_status": {
          "enum": [
            "open",
            "remediation_planned",
            "awaiting_approval",
            "remediating",
            "verifying",
            "resolved",
            "risk_accepted",
            "suppressed",
            "false_positive",
            "not_found"
          ]
        },
        "agent_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "agent_name": {
          "type": "string"
        },
        "policy_id": {
          "$ref": "common.v1.json#/$defs/policy_id"
        },
        "severity": {
          "$ref": "common.v1.json#/$defs/severity"
        },
        "finding_type": {
          "enum": [
            "violation",
            "insufficient_evidence"
          ]
        },
        "environment": {
          "type": "string"
        },
        "account_ref": {
          "type": "string"
        },
        "platform": {
          "$ref": "common.v1.json#/$defs/platform"
        },
        "remediation_attempts": {
          "$ref": "#/$defs/count"
        },
        "cooldown_active": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "exempt": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "deterministic_explanation": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "finding_status": {
            "not": {
              "const": "not_found"
            }
          }
        }
      },
      "then": {
        "required": [
          "agent_id",
          "agent_name",
          "policy_id",
          "severity",
          "finding_type",
          "environment",
          "account_ref",
          "platform",
          "remediation_attempts",
          "cooldown_active",
          "exempt",
          "deterministic_explanation"
        ]
      }
    },
    "reassess": {
      "title": "AI Governance - Reassess Agent",
      "type": "object",
      "required": [
        "assessment",
        "evaluation_id",
        "current_severity"
      ],
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "compliant",
            "noncompliant",
            "missing_evidence",
            "error"
          ]
        },
        "evaluation_id": {
          "type": "string",
          "description": "Empty when the agent could not be evaluated."
        },
        "current_severity": {
          "type": "string"
        },
        "policy_decision": {
          "type": "string"
        },
        "overall_status": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "candidate_actions": {
          "type": "string",
          "description": "Comma-separated catalog actions that fix the finding's policy on this platform (OPA policy_actions); input of the WF-02 AI step."
        },
        "remediation_summary": {
          "type": "string"
        }
      }
    },
    "plan": {
      "title": "AI Governance - Plan Remediation",
      "type": "object",
      "required": [
        "route",
        "reason",
        "action_type",
        "approval_summary",
        "rollback_available"
      ],
      "additionalProperties": false,
      "properties": {
        "remediation_id": {
          "type": "string",
          "description": "Empty when no remediation was recorded (route halt)."
        },
        "route": {
          "enum": [
            "auto",
            "approval",
            "simulate",
            "halt"
          ]
        },
        "reason": {
          "type": "string"
        },
        "action_type": {
          "type": "string"
        },
        "approval_summary": {
          "type": "string",
          "maxLength": 2000
        },
        "rollback_available": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "ai_agrees": {
          "enum": [
            "yes",
            "no",
            "invalid",
            "unknown"
          ]
        },
        "blast_radius": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "route_precheck": {
          "type": "string",
          "description": "OPA authorization pre-check: eligible, detect_only, denied, ... (empty when planning failed before OPA)."
        },
        "halt_outcome": {
          "enum": [
            "detect_only",
            "denied",
            "halted"
          ],
          "description": "The outcome WF-02 records when route is halt."
        },
        "preview": {
          "enum": [
            "yes",
            "no"
          ],
          "description": "yes: a preview (testing); nothing was recorded, so remediation_id is empty."
        }
      },
      "if": {
        "properties": {
          "route": {
            "enum": [
              "auto",
              "approval",
              "simulate"
            ]
          },
          "preview": {
            "not": {
              "const": "yes"
            }
          }
        }
      },
      "then": {
        "properties": {
          "remediation_id": {
            "$ref": "common.v1.json#/$defs/uuid"
          }
        },
        "required": [
          "remediation_id"
        ]
      }
    },
    "execute": {
      "title": "AI Governance - Execute Remediation",
      "type": "object",
      "required": [
        "remediation_id",
        "status",
        "changed",
        "action_type",
        "error_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "remediation_id": {
          "type": "string",
          "description": "Empty only when the inputs were invalid."
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "refused"
          ],
          "description": "refused: a precondition failed and nothing was changed (the remediation is marked skipped). failed: the action failed while executing."
        },
        "changed": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "action_type": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "remediation_id": {
            "$ref": "common.v1.json#/$defs/uuid"
          },
          "error_summary": {
            "const": ""
          }
        }
      }
    },
    "approval_decision": {
      "title": "AI Governance - Record Approval Decision",
      "type": "object",
      "required": [
        "remediation_id",
        "decision",
        "remediation_status"
      ],
      "additionalProperties": false,
      "properties": {
        "remediation_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "expired"
          ]
        },
        "remediation_status": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "remediation",
            "rollback"
          ]
        },
        "decided_by": {
          "type": "string"
        },
        "source": {
          "enum": [
            "manual",
            "ao"
          ]
        }
      }
    },
    "verify": {
      "title": "AI Governance - Verify Remediation",
      "type": "object",
      "required": [
        "remediation_id",
        "status",
        "evaluation_id",
        "target_policy_decision",
        "regressions",
        "simulation_admin_probes",
        "agent_status",
        "functional_check",
        "finding_status",
        "error_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "remediation_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "verification_failed",
            "error"
          ],
          "description": "error: no decision was made (the remediation is unchanged and Verify can run again)."
        },
        "evaluation_id": {
          "type": "string",
          "description": "The verification evaluation; empty on error."
        },
        "target_policy_decision": {
          "type": "string"
        },
        "regressions": {
          "$ref": "#/$defs/count"
        },
        "simulation_admin_probes": {
          "enum": [
            "all_denied",
            "some_allowed",
            "unknown",
            "not_applicable"
          ]
        },
        "agent_status": {
          "type": "string"
        },
        "functional_check": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "finding_status": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_id": {
            "$ref": "common.v1.json#/$defs/uuid"
          },
          "target_policy_decision": {
            "const": "pass"
          },
          "regressions": {
            "enum": [
              0,
              "0"
            ]
          },
          "finding_status": {
            "const": "resolved"
          },
          "simulation_admin_probes": {
            "enum": [
              "all_denied",
              "not_applicable"
            ]
          }
        }
      }
    },
    "rollback": {
      "title": "AI Governance - Rollback Remediation",
      "type": "object",
      "required": [
        "remediation_id",
        "status",
        "mode",
        "changed",
        "summary",
        "manual_steps",
        "error_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "remediation_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "rolled_back",
            "rollback_failed",
            "manual_required",
            "refused"
          ],
          "description": "manual_required: a step is denied to the remediation role by design (Q-11); nothing was changed and manual_steps lists what a person must do. refused: a precondition failed; nothing was changed."
        },
        "mode": {
          "enum": [
            "nothing",
            "automated",
            "manual",
            "none"
          ]
        },
        "changed": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "summary": {
          "type": "string"
        },
        "manual_steps": {
          "type": "string"
        },
        "error_summary": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "manual_required"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "manual"
              },
              "changed": {
                "const": "no"
              },
              "manual_steps": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rolled_back"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "enum": [
                  "automated",
                  "nothing"
                ]
              },
              "error_summary": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "title": "AI Governance - Record Remediation Outcome",
      "type": "object",
      "required": [
        "outcome",
        "finding_id",
        "remediation_id",
        "remediation_status",
        "rollback_offer",
        "cooldown_until",
        "audit_complete",
        "audit_missing",
        "notification",
        "incident"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "remediated",
            "detect_only",
            "denied",
            "simulated",
            "rejected",
            "expired",
            "failed",
            "verification_failed",
            "rolled_back",
            "escalated",
            "no_longer_detected",
            "missing_evidence",
            "assessment_error",
            "halted"
          ]
        },
        "finding_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "remediation_id": {
          "type": "string"
        },
        "remediation_status": {
          "type": "string"
        },
        "rollback_offer": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "cooldown_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_complete": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "audit_missing": {
          "type": "string"
        },
        "notification": {
          "enum": [
            "created",
            "updated",
            "resolved",
            "not_needed",
            "skipped",
            "failed"
          ]
        },
        "incident": {
          "type": "string"
        }
      }
    },
    "change_event": {
      "title": "AI Governance - Process Change Event",
      "type": "object",
      "required": [
        "change_event_id",
        "status",
        "reason",
        "event_name",
        "target",
        "agent_ids",
        "duplicate",
        "reassessment",
        "execution_id"
      ],
      "additionalProperties": false,
      "properties": {
        "change_event_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "status": {
          "enum": [
            "mapped",
            "ignored",
            "suppressed"
          ]
        },
        "reason": {
          "type": "string"
        },
        "event_name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "agent_ids": {
          "type": "string",
          "description": "Comma-separated inventory agent IDs (empty when no agent is affected)."
        },
        "duplicate": {
          "enum": [
            "yes",
            "no"
          ]
        },
        "reassessment": {
          "enum": [
            "started",
            "pending",
            "not_needed"
          ]
        },
        "execution_id": {
          "type": "string"
        }
      }
    },
    "assess_agents": {
      "title": "AI Governance - Assess Agents",
      "type": "object",
      "required": [
        "governance_run_id",
        "agents_evaluated",
        "agents_skipped",
        "new_violation_count",
        "new_violation_finding_ids",
        "change_event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "governance_run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "agents_evaluated": {
          "$ref": "#/$defs/count"
        },
        "agents_skipped": {
          "type": "string",
          "description": "Comma-separated agent IDs not evaluated (platform not re-collectable, or gone from AWS)."
        },
        "new_violation_count": {
          "$ref": "#/$defs/count"
        },
        "new_violation_finding_ids": {
          "type": "string",
          "description": "Comma-separated IDs of new or worsened violation findings (the remediation candidates)."
        },
        "change_event_id": {
          "type": "string"
        }
      }
    },
    "trigger_remediation": {
      "title": "AI Governance - Trigger Remediation Workflows",
      "type": "object",
      "required": [
        "started_count",
        "execution_ids",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "started_count": {
          "$ref": "#/$defs/count"
        },
        "execution_ids": {
          "type": "string"
        },
        "skipped": {
          "type": "string"
        }
      }
    }
  }
}
