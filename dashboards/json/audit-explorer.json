      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last checked",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM last_checked_at) * 1000 AS \"checked\" FROM reporting.audit_chain_status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "Never"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Selected run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT replace(run_type, '_', ' ') AS \"run type\", trigger_type AS trigger, status, started_at AS started, finished_at AS finished, duration_min AS minutes, agents_evaluated AS agents, findings_opened AS opened, findings_closed AS closed, ao_execution_id AS \"AO execution\" FROM reporting.governance_runs_recent WHERE governance_run_id = '$run'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "#0aac23",
                        "index": 0
                      },
                      "completed": {
                        "color": "#0aac23",
                        "index": 1
                      },
                      "failed": {
                        "color": "#dc3c3d",
                        "index": 2
                      },
                      "running": {
                        "color": "text",
                        "index": 3
                      },
                      "completed_with_errors": {
                        "color": "#f18a59",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "AO execution"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the execution in automation orchestrator",
                    "url": "${ao_url}/executions/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Audit timeline (selected run, in chain order)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_id AS \"#\", occurred_at AS time, actor_type AS actor, actor_id AS \"actor ID\", event_type AS event, coalesce(agent_name, '') AS agent, subject, source_system AS source, coalesce(source_ref, '') AS \"source ref\", details FROM reporting.audit_timeline WHERE governance_run_id = '$run' ORDER BY event_id"
        }
      ],
      "description": "Actors: ⚙️ service (automation), 📜 policy (OPA), 🤖 AI (advisory), 👤 human. Select a cell in details to inspect the full record. Empty when: no audit events for this run.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "service": {
                        "text": "⚙️ service",
                        "index": 0
                      },
                      "policy": {
                        "text": "📜 policy",
                        "index": 1
                      },
                      "ai": {
                        "text": "🤖 AI",
                        "index": 2
                      },
                      "human": {
                        "text": "👤 human",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Policy bundle revisions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
