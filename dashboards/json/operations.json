          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT waiting_minutes AS \"waiting (min)\", agent_name AS agent, policy_id AS policy, severity, action_type AS action, requested_at AS requested, ao_execution_id AS \"AO execution\", remediation_id FROM reporting.pending_approvals ORDER BY waiting_minutes DESC"
        }
      ],
      "description": "automation orchestrator expires an approval after 60 minutes; the remediation is then recorded as expired. Empty when: no remediation is waiting for approval.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "waiting (min)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#fbb315",
                      "value": 45
                    },
                    {
                      "color": "#dc3c3d",
                      "value": 60
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "#dc3c3d",
                        "index": 0
                      },
                      "high": {
                        "color": "#f18a59",
                        "index": 1
                      },
                      "medium": {
                        "color": "#fbb315",
                        "index": 2
                      },
                      "low": {
                        "color": "#8e8e8e",
                        "index": 3
                      },
