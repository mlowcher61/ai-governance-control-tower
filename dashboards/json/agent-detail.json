          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT policy_type AS type, policy_name AS policy, statements, grants_all_actions AS \"all actions\", flagged_admin AS \"administrator (IAM-001)\", flagged_dangerous AS \"dangerous (IAM-002)\", policy_ref FROM reporting.agent_permissions WHERE agent_id = '$agent' ORDER BY flagged_admin DESC, flagged_dangerous DESC, policy_name"
