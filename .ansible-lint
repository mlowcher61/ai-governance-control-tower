---
profile: production
offline: true
exclude_paths:
  - .github/
  - docs/
  - ao_workflows/reference/
  - aws/cloudformation/
  - collections/ansible_collections/amazon/
  - collections/ansible_collections/ansible/
  - collections/ansible_collections/infra/
  - collections/ansible_collections/kubernetes/
  - collections/ansible_collections/servicenow/
kinds:
  - tasks: "**/playbooks/**/tasks/*.yml"
  - vars: "**/playbooks/**/vars/*.yml"
  - playbook: "**/playbooks/**/*.yml"
  - playbook: "aap_config/configure_aap.yml"
  - playbook: "ao_workflows/*.yml"
  - tasks: "ao_workflows/tasks/*.yml"
  - vars: "ao_workflows/config/*.yml"
  - yaml: "ao_workflows/definitions/*.yml"
  - vars: "aap_config/group_vars/**/*.yml"
  - vars: "aap_config/vars/*.yml"
# Every variable in this project uses the aigov_ prefix, across playbooks and the collection roles: AAP
# credentials inject aigov_* extra vars (aigov_api_url, aigov_discovery_role_arn, ...) and the discovery
# roles pass aigov_scope_records between each other. Role-name prefixes would break that shared contract.
skip_list:
  - var-naming[no-role-prefix]
