---
extends: default
ignore: |
  collections/ansible_collections/*/
  !collections/ansible_collections/mlowcher61/
  ao_workflows/reference/
  .github/
rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
