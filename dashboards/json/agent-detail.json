          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS created, status, action_type AS action, policy_id AS policy, severity, route, coalesce(decided_by, '-') AS \"decided by\", aap_job_ids[cardinality(aap_job_ids)] AS \"last AAP job\", ao_execution_id AS \"AO execution\" FROM reporting.remediations WHERE agent_id = '$agent' ORDER BY created_at DESC LIMIT 50"
