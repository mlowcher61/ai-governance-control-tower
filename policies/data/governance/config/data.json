{
  "bundle_revision": "local",
  "unknown_environment_treatment": "assume_production",
  "known_environments": [
    "production",
    "staging",
    "development",
    "sandbox"
  ],
  "tag_keys": {
    "owner": "Owner",
    "environment": "Environment",
    "data_classification": "DataClassification",
    "cost_center": "CostCenter"
  },
  "required_production_tags": [
    "Owner",
    "Environment",
    "DataClassification",
    "CostCenter"
  ],
  "data_classifications": [
    "public",
    "internal",
    "confidential",
    "restricted"
  ],
  "sensitive_classifications": [
    "confidential",
    "restricted"
  ],
  "approved_models": [
    "amazon.nova-pro-v1:0",
    "amazon.nova-lite-v1:0",
    "anthropic.claude-3-5-haiku-20241022-v1:0"
  ],
  "admin_policy_arns": [
    "arn:aws:iam::aws:policy/AdministratorAccess",
    "arn:aws:iam::aws:policy/IAMFullAccess",
    "arn:aws:iam::aws:policy/PowerUserAccess"
  ],
  "admin_probe_actions": [
    "iam:CreateUser",
    "iam:AttachRolePolicy",
    "iam:PutRolePolicy"
  ],
  "dangerous_actions": [
    "iam:PassRole",
    "sts:AssumeRole",
    "s3:*",
    "kms:Decrypt",
    "secretsmanager:GetSecretValue",
    "lambda:UpdateFunctionCode",
    "bedrock:*"
  ],
  "high_risk_tool_signatures": [
    "ANTHROPIC.Computer",
    "ANTHROPIC.Bash",
    "ANTHROPIC.TextEditor",
    "AMAZON.CodeInterpreter"
  ],
  "risk_weights": {
    "admin_permissions": 40,
    "sensitive_data_without_approval": 20,
    "unregistered_agent": 15,
    "dangerous_permissions": 15,
    "high_risk_tools_unapproved": 15,
    "sensitive_data_present": 10,
    "no_approved_owner": 10,
    "unapproved_model": 10,
    "production_environment": 10,
    "insufficient_evidence_each": 5,
    "insufficient_evidence_max": 15
  },
  "risk_categories": {
    "critical": 70,
    "high": 45,
    "medium": 21
  },
  "control_sources": {
    "rego_policy_libraries": {
      "repository": "https://github.com/ynotbhatc/rego_policy_libraries",
      "commit": "9d26ac4",
      "note": "Control identifiers follow this library's benchmarks/cis/aws (CIS AWS Foundations v7), governance/iso_42001, governance/eu_ai_act, governance/owasp_llm and frameworks/federal/nist/ai_rmf modules."
    }
  },
  "controls": {
    "AIGOV-REG-001": [
      "NIST-AI-RMF:GOVERN-1.6",
      "ISO42001:A.4.2",
      "EU-AI-ACT:Art.49",
      "ENT-AI-INVENTORY"
    ],
    "AIGOV-OWN-001": [
      "NIST-AI-RMF:GOVERN-2.1",
      "ISO42001:A.3.2",
      "ENT-AI-OWNERSHIP"
    ],
    "AIGOV-TAG-001": [
      "NIST-AI-RMF:MAP-1.1",
      "ISO42001:A.6.2.7",
      "ENT-TAGGING"
    ],
    "AIGOV-IAM-001": [
      "CIS-AWS-v7:7.1.3",
      "NIST-AI-RMF:MEASURE-2.7",
      "ISO42001:A.6.2.6",
      "OWASP-LLM:LLM06",
      "ENT-IAM-LEAST-PRIVILEGE"
    ],
    "AIGOV-IAM-002": [
      "CIS-AWS-v7:7.1.3",
      "NIST-AI-RMF:MEASURE-2.7",
      "OWASP-LLM:LLM06",
      "ENT-IAM-LEAST-PRIVILEGE"
    ],
    "AIGOV-DATA-001": [
      "NIST-AI-RMF:MEASURE-2.10",
      "ISO42001:A.7.2",
      "CIS-AWS-v7:7.3.2",
      "ENT-DATA-APPROVAL"
    ],
    "AIGOV-MDL-001": [
      "CIS-AWS-v7:7.1.4",
      "NIST-AI-RMF:MAP-1.1",
      "ISO42001:A.10.3",
      "ENT-AI-MODEL-APPROVAL"
    ],
    "AIGOV-RSK-001": [
      "NIST-AI-RMF:MEASURE-3.1",
      "ISO42001:A.5",
      "EU-AI-ACT:Art.9",
      "ENT-AI-RISK-ASSESSMENT"
    ],
    "AIGOV-TOOL-001": [
      "OWASP-LLM:LLM06",
      "CIS-AWS-v7:7.1.3",
      "ISO42001:A.9",
      "ENT-AI-TOOL-APPROVAL"
    ],
    "AIGOV-GRD-001": [
      "CIS-AWS-v7:7.2.1",
      "OWASP-LLM:LLM01",
      "NIST-AI-RMF:MANAGE-2.4",
      "ENT-AI-GUARDRAILS"
    ]
