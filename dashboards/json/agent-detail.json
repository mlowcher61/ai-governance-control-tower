        "query": "SELECT name AS __text, agent_id::text AS __value FROM reporting.agent_current ORDER BY risk_rank, name",
        "definition": "SELECT name AS __text, agent_id::text AS __value FROM reporting.agent_current ORDER BY risk_rank, name",
