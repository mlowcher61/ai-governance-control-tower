{
  "uid": "aigov-audit-explorer",
  "title": "AI Governance - Audit Explorer",
  "description": "The hash-chained audit trail: chain verification, every event of a governance run in order, human and AI actions, and the policy revisions used. Provisioned from Git (dashboards/json/).",
  "tags": [
    "ai-governance"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Governance run",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "aigov-postgres"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "query": "SELECT to_char(started_at AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') || ' UTC · ' || replace(run_type, '_', ' ') || ' · ' || status AS __text, governance_run_id::text AS __value FROM reporting.governance_runs_recent ORDER BY started_at DESC LIMIT 300",
        "definition": "SELECT to_char(started_at AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') || ' UTC · ' || replace(run_type, '_', ' ') || ' · ' || status AS __text, governance_run_id::text AS __value FROM reporting.governance_runs_recent ORDER BY started_at DESC LIMIT 300"
      },
      {
        "name": "ao_url",
        "type": "constant",
        "hide": 2,
        "query": "__AIGOV_AO_URL__",
        "skipUrlSync": true,
        "current": {
          "text": "__AIGOV_AO_URL__",
          "value": "__AIGOV_AO_URL__"
        }
      },
      {
        "name": "aap_url",
        "type": "constant",
        "hide": 2,
        "query": "__AIGOV_AAP_URL__",
        "skipUrlSync": true,
        "current": {
          "text": "__AIGOV_AAP_URL__",
          "value": "__AIGOV_AAP_URL__"
        }
      },
      {
        "name": "repo_url",
        "type": "constant",
        "hide": 2,
        "query": "__AIGOV_REPO_URL__",
        "skipUrlSync": true,
        "current": {
          "text": "__AIGOV_REPO_URL__",
          "value": "__AIGOV_REPO_URL__"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "AI Governance dashboards",
      "type": "dashboards",
      "tags": [
        "ai-governance"
      ],
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Audit hash chain",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aigov-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT chain_status FROM reporting.audit_chain_status"
        }
      ],
      "description": "The last check by Reconcile and Sweep. Every audit event is hash-chained to the previous one; an altered or removed event breaks the chain, fails the job and opens a ServiceNow incident.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "Not checked yet (hourly)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "intact": {
                  "color": "#0aac23",
                  "index": 0,
                  "text": "✔ intact"
                },
                "broken": {
                  "color": "#dc3c3d",
                  "index": 1,
                  "text": "✖ broken"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Verified through event",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aigov-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
