  "remediation": {
    "enabled": false,
    "mode": "detect_only",
    "allowed_accounts": [],
    "auto_remediation_actions": [],
    "max_attempts": 3,
    "cooldown_minutes": 60
  },
  "aap_guard": {
    "_comment": "AAP launch guard (aap.remediation_guard, T2.11): who may launch Execute/Rollback Remediation directly, and which extra variables those launches may carry.",
    "allowed_users": [
      "svc-aigov-ao"
    ],
    "break_glass_teams": [
      "AI Governance - Break Glass"
    ],
    "allowed_extra_vars": [
      "aigov_governance_run_id",
      "aigov_remediation_id",
      "aigov_opa_url",
      "aigov_aws_region"
    ]
  }
}
